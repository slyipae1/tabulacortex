# Copy this file to `.env` and fill in values for a real run.
# Never commit the real `.env` file.

# OpenAI-compatible model id used by smolagents.OpenAIModel
MODEL_NAME=your-model-name

# Base URL of the OpenAI-compatible endpoint (include the /v1 suffix if needed)
BASE_URL=https://your-openai-compatible-endpoint.example/v1

# API key for that endpoint
API_KEY=your-api-key
